# ---- Supabase (دیتابیس و ورود کاربران) ----
# از داشبورد Supabase > Project Settings > API
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
# فقط سمت سرور؛ هرگز در کد فرانت‌اند یا گیت‌هاب قرار ندهید
SUPABASE_SERVICE_ROLE_KEY=""

# همان مقادیر بالا برای مرورگر (هنگام build داخل کد قرار می‌گیرند)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# ---- هوش مصنوعی (چت تشخیص و پیشنهاد آبیاری) ----
# پیش‌فرض: Google Gemini با سهمیه‌ی رایگان. کلید رایگان از https://aistudio.google.com/apikey
AI_API_KEY=""
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# مدل باید از عکس پشتیبانی کند (برای تشخیص از روی عکس)
AI_MODEL="gemini-flash-latest"

# جایگزین رایگان: OpenRouter (کلید از https://openrouter.ai/keys)
# AI_BASE_URL="https://openrouter.ai/api/v1"
# AI_MODEL="google/gemma-3-27b-it:free"

# ---- سرور ----
PORT=3000
