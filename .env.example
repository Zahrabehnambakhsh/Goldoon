# ---- Supabase (دیتابیس و ورود کاربران) ----
# از داشبورد Supabase > Project Settings > API
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
# فقط سمت سرور؛ هرگز در کد فرانت‌اند یا گیت‌هاب قرار ندهید
SUPABASE_SERVICE_ROLE_KEY=""

# اختیاری: اگر این دو را بدهید هنگام build داخل کد قرار می‌گیرند؛
# اگر خالی بمانند، برنامه هنگام اجرا از SUPABASE_URL و SUPABASE_PUBLISHABLE_KEY استفاده می‌کند.
# VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# ---- هوش مصنوعی (چت تشخیص و پیشنهاد آبیاری) ----
# پیش‌فرض: Google Gemini با سهمیه‌ی رایگان. کلید رایگان از https://aistudio.google.com/apikey
AI_API_KEY=""
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# مدل باید از عکس پشتیبانی کند (برای تشخیص از روی عکس)
AI_MODEL="gemini-flash-latest"

# سرور داخل ایران (مثل همروش): گوگل و OpenRouter از ایران در دسترس نیستند؛
# از سرویس ایرانی سازگار با OpenAI مثل AvalAI استفاده کنید (کلید از https://avalai.ir)
# AI_BASE_URL="https://api.avalai.ir/v1"
# AI_MODEL="gemini-2.5-flash"

# جایگزین رایگان: OpenRouter (کلید از https://openrouter.ai/keys)
# AI_BASE_URL="https://openrouter.ai/api/v1"
# AI_MODEL="google/gemma-3-27b-it:free"

# ---- ثبت‌نام ----
# false (پیش‌فرض): فقط کاربران دعوت‌شده با ایمیل و رمز وارد می‌شوند؛ ثبت‌نام، موبایل و گوگل مخفی‌اند.
# true: ثبت‌نام، ورود با موبایل و گوگل نمایش داده می‌شوند.
SIGNUP_OPEN=false

# ---- ورود با موبایل (پیامک از کاوه‌نگار) ----
# کلید API از پنل kavenegar.com
KAVENEGAR_API_KEY=""
# نام الگوی «تأیید» در کاوه‌نگار که %token% آن کد ورود است (پیشنهادی)
KAVENEGAR_TEMPLATE=""
# اگر الگو ندارید: شمارهٔ خط ارسال‌کننده برای پیامک معمولی
# KAVENEGAR_SENDER=""
# رمز Hook که Supabase می‌دهد (Authentication > Hooks > Send SMS)، مثل v1,whsec_...
SEND_SMS_HOOK_SECRET=""

# ---- سرور ----
PORT=3000
